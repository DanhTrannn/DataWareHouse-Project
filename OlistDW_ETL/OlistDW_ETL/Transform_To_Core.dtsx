  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{51D0833F-6F9D-4F84-8588-C931491CF228}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="INSERT INTO core.products&#xA;SELECT DISTINCT &#xA;    TRIM(product_id) AS product_id,&#xA;    ISNULL(NULLIF(TRIM(product_category_name), ''), 'unknown') AS product_category_name,&#xA;    ISNULL(product_name_length, 0) AS product_name_length,&#xA;    ISNULL(product_description_length, 0) AS product_description_length,&#xA;    ISNULL(product_photos_qty, 0) AS product_photos_qty,&#xA;    ISNULL(product_weight_g, 0) AS product_weight_g,&#xA;    ISNULL(product_length_cm, 0) AS product_length_cm,&#xA;    ISNULL(product_height_cm, 0) AS product_height_cm,&#xA;    ISNULL(product_width_cm, 0) AS product_width_cm&#xA;FROM staging.stg_products&#xA;WHERE product_id IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_StagingToCoreCategory"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9EA98CD7-84AC-439A-A88B-C57ED5C74FE0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_StagingToCoreCategory"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="INSERT INTO core.category_translation&#xA;SELECT DISTINCT&#xA;    TRIM(product_category_name) AS product_category_name,&#xA;    ISNULL(NULLIF(TRIM(product_category_name_english), ''), 'Unknown') AS product_category_name_english&#xA;FROM staging.stg_category_translation&#xA;WHERE product_category_name IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_StagingToCoreCustomer"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FC6434A9-63AD-44DC-B8D1-9B9473E4E37F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_StagingToCoreCustomer"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="INSERT INTO core.customers&#xA;SELECT&#xA;    TRIM(customer_id) AS customer_id,&#xA;    TRIM(customer_unique_id) AS customer_unique_id,&#xA;    ISNULL(NULLIF(TRIM(customer_zip_code_prefix), ''), '00000') AS customer_zip_code_prefix,&#xA;    ISNULL(NULLIF(TRIM(customer_city), ''), 'Unknown') AS customer_city,&#xA;    UPPER(ISNULL(NULLIF(TRIM(customer_state), ''), 'NA')) AS customer_state&#xA;FROM staging.stg_customers&#xA;WHERE customer_id IS NOT NULL AND customer_unique_id IS NOT NULL&#xA;GROUP BY &#xA;    customer_id, &#xA;    customer_unique_id, &#xA;    customer_zip_code_prefix, &#xA;    customer_city, &#xA;    customer_state;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_StagingToCoreGeo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{57464F8A-3AC1-4AAB-B5B7-7F639457F9CF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_StagingToCoreGeo"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="INSERT INTO core.geolocation&#xA;SELECT DISTINCT&#xA;    TRIM(geolocation_zip_code_prefix) AS geolocation_zip_code_prefix,&#xA;    ISNULL(geolocation_lat, 0) AS geolocation_lat,&#xA;    ISNULL(geolocation_lng, 0) AS geolocation_lng,&#xA;    ISNULL(NULLIF(TRIM(geolocation_city), ''), 'Unknown') AS geolocation_city,&#xA;    UPPER(ISNULL(NULLIF(TRIM(geolocation_state), ''), 'NA')) AS geolocation_state&#xA;FROM staging.stg_geolocation&#xA;WHERE geolocation_zip_code_prefix IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_StagingToCoreOrder"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{387D0121-5788-4F68-97F3-EC0916A62119}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_StagingToCoreOrder"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="INSERT INTO core.orders&#xA;SELECT DISTINCT&#xA;    TRIM(order_id) AS order_id,&#xA;    TRIM(customer_id) AS customer_id,&#xA;    UPPER(ISNULL(NULLIF(TRIM(order_status), ''), 'UNKNOWN')) AS order_status,&#xA;    ISNULL(order_purchase_timestamp, '1900-01-01') AS order_purchase_timestamp,&#xA;    order_approved_at,&#xA;    order_delivered_carrier_date,&#xA;    order_delivered_customer_date,&#xA;    order_estimated_delivery_date&#xA;FROM staging.stg_orders&#xA;WHERE order_id IS NOT NULL &#xA;  AND customer_id IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_StagingToCoreOrderItems"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0DC5CA05-39EC-415E-A1FC-AAFCCA28957B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_StagingToCoreOrderItems"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="INSERT INTO core.order_items&#xA;SELECT DISTINCT&#xA;    TRIM(order_id) AS order_id,&#xA;    order_item_id,&#xA;    TRIM(product_id) AS product_id,&#xA;    TRIM(seller_id) AS seller_id,&#xA;    shipping_limit_date,&#xA;    ISNULL(price, 0.00) AS price,&#xA;    ISNULL(freight_value, 0.00) AS freight_value&#xA;FROM staging.stg_order_items&#xA;WHERE order_id IS NOT NULL&#xA;  AND product_id IS NOT NULL&#xA;  AND seller_id IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_StagingToCoreOrderPayment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FB0D89BA-03EE-4996-BEF8-C75BBD7F914E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_StagingToCoreOrderPayment"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="INSERT INTO core.order_payments&#xA;SELECT DISTINCT&#xA;    TRIM(order_id) AS order_id,&#xA;    ISNULL(payment_sequential, 1) AS payment_sequential,&#xA;    LOWER(ISNULL(NULLIF(TRIM(payment_type), ''), 'unknown')) AS payment_type,&#xA;    ISNULL(payment_installments, 1) AS payment_installments,&#xA;    ISNULL(payment_value, 0.00) AS payment_value&#xA;FROM staging.stg_order_payments&#xA;WHERE order_id IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_StagingToCoreReview"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CD9B581D-A8EC-45DF-A63F-EC425DC3ED3B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_StagingToCoreReview"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="INSERT INTO core.order_reviews&#xA;SELECT DISTINCT&#xA;    TRIM(review_id) AS review_id,&#xA;    TRIM(order_id) AS order_id,&#xA;    CASE &#xA;        WHEN review_score &lt; 1 OR review_score &gt; 5 THEN NULL &#xA;        ELSE review_score &#xA;    END AS review_score,&#xA;    ISNULL(NULLIF(TRIM(review_comment_title), ''), '') AS review_comment_title,&#xA;    ISNULL(NULLIF(TRIM(review_comment_message), ''), '') AS review_comment_message,&#xA;    review_creation_date,&#xA;    review_answer_timestamp&#xA;FROM staging.stg_order_reviews&#xA;WHERE review_id IS NOT NULL AND order_id IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_StagingToCoreSeller"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{17CAF069-3382-45EE-ABF2-6316D6697056}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_StagingToCoreSeller"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="INSERT INTO core.sellers&#xA;SELECT DISTINCT&#xA;    TRIM(seller_id) AS seller_id,&#xA;    ISNULL(NULLIF(TRIM(seller_zip_code_prefix), ''), '00000') AS seller_zip_code_prefix,&#xA;    ISNULL(NULLIF(TRIM(seller_city), ''), 'Unknown') AS seller_city,&#xA;    UPPER(ISNULL(NULLIF(TRIM(seller_state), ''), 'NA')) AS seller_state&#xA;FROM staging.stg_sellers&#xA;WHERE seller_id IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_TruncateCoreTables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{04E0CF92-5521-4FE0-B968-35317F01E589}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_TruncateCoreTables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EBD54FEC-B16B-4A71-820D-637DA8D41382}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE core.category_translation;&#xA;TRUNCATE TABLE core.order_reviews;&#xA;TRUNCATE TABLE core.order_payments;&#xA;TRUNCATE TABLE core.order_items;&#xA;TRUNCATE TABLE core.orders;&#xA;TRUNCATE TABLE core.products;&#xA;TRUNCATE TABLE core.sellers;&#xA;TRUNCATE TABLE core.geolocation;&#xA;TRUNCATE TABLE core.customers;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
