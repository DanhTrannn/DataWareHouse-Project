                      externalMetadataColumnId="Package\DFT - Load fact_delivery\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[total_orders_delivered]"
                      lineageId="Package\DFT - Load fact_delivery\OLE DB Source.Outputs[OLE DB Source Output].Columns[total_orders_delivered]"
