                      externalMetadataColumnId="Package\DFT - Load fact_delivery\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[on_time_rate]"
                      lineageId="Package\DFT - Load fact_delivery\OLE DB Source.Outputs[OLE DB Source Output].Columns[on_time_rate]"
                      name="on_time_rate"
                      precision="5"
