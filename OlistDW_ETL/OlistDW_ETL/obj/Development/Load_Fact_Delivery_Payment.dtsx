                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\DFT - Load fact_delivery\OLE DB Source.Outputs[OLE DB Source Output].Columns[on_time_rate]"
                      dataType="numeric"
                      errorOrTruncationOperation="Conversion"
