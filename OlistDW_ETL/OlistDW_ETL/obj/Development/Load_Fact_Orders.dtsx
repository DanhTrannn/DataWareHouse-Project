            <component
              refId="Package\DFT - Load fact_orders (Incremental)\Load fact_orders (New Record)"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Load fact_orders (New Record)"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH LatestReviews AS (
    SELECT 
        order_id,
        review_score,
        -- Sắp xếp để lấy review mới nhất lên đầu (rn = 1)
        ROW_NUMBER() OVER (
            PARTITION BY order_id 
            ORDER BY review_creation_date DESC, review_answer_timestamp DESC
        ) AS rn
    FROM core.order_reviews
)
SELECT
    oi.order_id,
    oi.order_item_id,
    o.customer_id,
    oi.seller_id,
    oi.product_id,
    o.order_status,
    o.order_purchase_timestamp,
    o.order_approved_at,
    o.order_delivered_customer_date,
    o.order_estimated_delivery_date,
    oi.price,
    oi.freight_value,
    1 AS quantity,
    r.review_score
FROM core.order_items oi
INNER JOIN core.orders o
    ON oi.order_id = o.order_id
LEFT JOIN LatestReviews r
    ON o.order_id = r.order_id
    AND r.rn = 1 -- CHỈ LẤY REVIEW MỚI NHẤT
WHERE NOT EXISTS (
    SELECT 1 FROM datamart.fact_orders f
    WHERE f.order_id = oi.order_id
      AND f.order_item_id = oi.order_item_id
);</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
